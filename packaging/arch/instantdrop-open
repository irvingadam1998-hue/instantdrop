#!/bin/bash
# Lanzador de escritorio: abre InstantDrop en su propia ventana (modo app de
# un navegador Chromium), sin barra de direcciones ni pestañas.
#
# Por defecto apunta a la instancia pública (https://instantdrop.site) para
# que los dispositivos se detecten entre sí — todos comparten el mismo
# servidor. Un servidor local propio (systemctl --user start
# instantdrop.service) es una instancia separada y NO comparte dispositivos
# con la instancia pública ni con otras instancias locales.
#
# Para apuntar a tu propio servidor local en su lugar:
#   INSTANTDROP_URL="http://$(hostname -I | awk '{print $1}'):3000" instantdrop-open
set -e
URL="${INSTANTDROP_URL:-https://instantdrop.site}"
PROFILE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/instantdrop/app-profile"

for browser in brave-browser brave google-chrome-stable google-chrome \
  chromium chromium-browser vivaldi-stable vivaldi \
  microsoft-edge-stable microsoft-edge; do
  if command -v "$browser" >/dev/null 2>&1; then
    mkdir -p "$PROFILE_DIR"
    exec "$browser" \
      "--app=${URL}" \
      "--user-data-dir=${PROFILE_DIR}" \
      "--class=InstantDrop" \
      "--name=InstantDrop"
  fi
done

# Ningún navegador Chromium instalado: abrir en el navegador predeterminado (pestaña normal)
xdg-open "$URL" >/dev/null 2>&1 &
