# Public URL of the deployed @instantdrop/server backend. Required in
# production — Next.js inlines this at BUILD time, so set it before running
# `npm run build` (or as a build arg if using the Dockerfile).
# Example: NEXT_PUBLIC_SERVER_URL=https://instantdrop-server.onrender.com
NEXT_PUBLIC_SERVER_URL=

# Enables search indexing and the public sitemap only for the real production
# domain. Use production (or prod) there; omit it for previews and development.
NEXT_PUBLIC_APP_ENV=development

# Google Analytics 4 measurement ID. Leave blank outside real production.
# Example: NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Only used as a fallback when NEXT_PUBLIC_SERVER_URL is unset (local/LAN dev):
# the browser will call http(s)://<same-hostname-as-this-page>:<this-port>/api/...
# Must match PORT in apps/server/.env. Defaults to 4000.
NEXT_PUBLIC_SERVER_PORT=4000

# Canonical public origin used for metadata, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://instantdrop.site
