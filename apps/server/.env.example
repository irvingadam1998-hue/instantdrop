# Port the Express server listens on. Render sets this automatically — you
# normally don't need to set it yourself in production.
PORT=4000

# production | development. Also read from APP_ENV if you prefer that name.
NODE_ENV=development

# Pins every client hitting this deployment to one fixed room, regardless of
# hostname or client IP. Set this on Render so the room stays stable even
# behind a proxy/CDN/custom domain. Leave unset for local multi-room testing.
# Example: APP_ROOM_ID=OFFICE-LAN
APP_ROOM_ID=

# Origin(s) of the deployed Next.js frontend, comma-separated, for CORS.
# Example: FRONTEND_URL=https://instantdrop-web.onrender.com
FRONTEND_URL=
